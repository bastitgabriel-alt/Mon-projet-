{
  "type": "header",
  "name": "t:names.header",
  "sections": {
    "bandeau": {
      "type": "epure-bandeau",
      "blocks": {
        "m1": {
          "type": "text",
          "settings": {
            "text": "<p>Livraison offerte</p>",
            "width": "fit-content",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "custom",
            "font": "var(--font-body--family)",
            "font_size": "0.8125rem",
            "line_height": "tight",
            "letter_spacing": "loose",
            "case": "uppercase",
            "wrap": "nowrap",
            "text_color": "",
            "background": false,
            "corner_radius": 0
          }
        },
        "m2": {
          "type": "text",
          "settings": {
            "text": "<p>Retours sous 14 jours</p>",
            "width": "fit-content",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "custom",
            "font": "var(--font-body--family)",
            "font_size": "0.8125rem",
            "line_height": "tight",
            "letter_spacing": "loose",
            "case": "uppercase",
            "wrap": "nowrap",
            "text_color": "",
            "background": false,
            "corner_radius": 0
          }
        },
        "m3": {
          "type": "text",
          "settings": {
            "text": "<p>Du S au 3XL</p>",
            "width": "fit-content",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "custom",
            "font": "var(--font-body--family)",
            "font_size": "0.8125rem",
            "line_height": "tight",
            "letter_spacing": "loose",
            "case": "uppercase",
            "wrap": "nowrap",
            "text_color": "",
            "background": false,
            "corner_radius": 0
          }
        },
        "m4": {
          "type": "text",
          "settings": {
            "text": "<p>Maille tricotée sans couture</p>",
            "width": "fit-content",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "custom",
            "font": "var(--font-body--family)",
            "font_size": "0.8125rem",
            "line_height": "tight",
            "letter_spacing": "loose",
            "case": "uppercase",
            "wrap": "nowrap",
            "text_color": "",
            "background": false,
            "corner_radius": 0
          }
        }
      },
      "block_order": ["m1", "m2", "m3", "m4"],
      "settings": {
        "movement_direction": "normal",
        "background_color": "{{ settings.color_palette.color2 }}",
        "padding-block-start": 10,
        "padding-block-end": 10,
        "gap_between_elements": 48
      }
    },
    "header_section": {
      "type": "header",
      "blocks": {
        "header-logo": {
          "type": "_header-logo",
          "static": true,
          "settings": {
            "hide_logo_on_home_page": false,
            "padding-block-start": 0,
            "padding-block-end": 0
          },
          "blocks": {}
        },
        "header-menu": {
          "type": "_header-menu",
          "static": true,
          "settings": {
            "menu": "main-menu",
            "background_color": "{{ settings.color_palette.background }}",
            "text_color": "",
            "type_font_primary_size": "0.875rem",
            "menu_font_style": "inverse",
            "type_font_primary_link": "body",
            "type_case_primary_link": "uppercase",
            "menu_style": "featured_products",
            "featured_products_aspect_ratio": "4 / 5",
            "featured_collections_aspect_ratio": "16 / 9",
            "image_border_radius": 2,
            "navigation_bar": false,
            "background_color_navigation_bar": "{{ settings.color_palette.background }}",
            "text_color_navigation_bar": "",
            "drawer_accordion": false,
            "drawer_accordion_expand_first": false,
            "drawer_dividers": false
          },
          "blocks": {}
        }
      },
      "settings": {
        "logo_position": "left",
        "menu_position": "center",
        "menu_row": "top",
        "customer_account_menu": "customer-account-main-menu",
        "show_search": true,
        "search_position": "right",
        "search_row": "top",
        "show_country": true,
        "country_selector_style": false,
        "show_language": true,
        "localization_font": "body",
        "localization_font_size": "0.875rem",
        "localization_position": "right",
        "localization_row": "top",
        "section_width": "page-width",
        "section_height": "standard",
        "enable_sticky_header": "scroll-up",
        "divider_width": 0,
        "divider_size": "page-width",
        "divider_color": "",
        "border_width": 0,
        "bottom_border_color": "",
        "actions_display_style": "icon",
        "actions_font_size": "0.875rem",
        "actions_font": "body",
        "actions_text_case": "uppercase",
        "background_color_top": "{{ settings.color_palette.color8 }}",
        "text_color_top": "",
        "background_color_bottom": "",
        "text_color_bottom": "",
        "bubble_style": "default",
        "bubble_background_color": "",
        "bubble_text_color": "",
        "enable_transparent_header_home": false,
        "home_inverse_logo": false,
        "text_color_transparent_home": "{{ settings.color_palette.foreground }}",
        "enable_transparent_header_product": false,
        "product_inverse_logo": false,
        "text_color_transparent_product": "{{ settings.color_palette.foreground }}",
        "enable_transparent_header_collection": false,
        "collection_inverse_logo": false,
        "text_color_transparent_collection": "{{ settings.color_palette.foreground }}"
      }
    }
  },
  "order": ["bandeau", "header_section"]
}
