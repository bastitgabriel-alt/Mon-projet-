# URL du projet Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Cle "service_role" Supabase (Project Settings > API) -- NE JAMAIS exposer cote frontend
SUPABASE_SERVICE_ROLE_KEY=

# Port d'ecoute du serveur API
PORT=3001

# Origine(s) autorisee(s) pour CORS (frontend), separees par des virgules
CORS_ORIGIN=http://localhost:5173
